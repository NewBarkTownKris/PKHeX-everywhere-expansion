<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PKHeX.Facade.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PKHeX.Facade\PKHeX.Facade.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="../../profiles/*.json" LogicalName="profiles.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Quetzal/quetzal-9-v1.json" LogicalName="quetzal.9v1.json" />
        <EmbeddedResource Include="Historic/gb-*.json" LogicalName="historic.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Historic/vba-*.json" LogicalName="historic.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Historic/liquid-crystal-places.json" LogicalName="historic.liquid-crystal-places.json" />
        <EmbeddedResource Include="Historic/liquid-crystal-tables.json" LogicalName="historic.liquid-crystal-tables.json" />
        <EmbeddedResource Include="Historic/dark-rising-tables.json" LogicalName="historic.dark-rising-tables.json" />
        <EmbeddedResource Include="Historic/recharged-yellow-tables.json" LogicalName="historic.recharged-yellow-tables.json" />
    </ItemGroup>
</Project>
